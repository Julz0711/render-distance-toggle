{
	"schemaVersion": 1,
	"id": "render-toggle",
	"version": "${version}",
	"name": "Render Toggle",
	"description": "Toggles shaders and render distance with a keybind.",
	"authors": [
		"Me"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/render-toggle/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.rendertoggle.RenderToggleMod"
		],
		"client": [
			"com.example.rendertoggle.client.RenderToggleClientMod"
		],
		"modmenu": [
			"com.example.rendertoggle.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		"render-toggle.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
